# Copy to .env and fill in. .env is gitignored and never committed.
# The CLI can also prompt for these and write the file for you.

# Higgsfield — required. Create a key pair at https://cloud.higgsfield.ai
# It is issued as ID:SECRET; put the two halves in separately.
HF_API_KEY=
HF_API_SECRET=

# Anthropic — optional. Lets Claude describe each photograph so the repaint
# keeps that specific scene. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the image-to-image model used for the repaint.
# IMPASTO_MODEL=bytedance/seedream/v4/image-to-image
